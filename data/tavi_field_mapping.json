  "complex_queries": {
    "death_with_heart_failure": {
      "description": "出院前死亡（心力衰竭）",
      "conditions": [
        {"field": "death_before_discharge", "value": true},
        {"field": "heart_failure", "value": true}
      ]
    },
    "immediate_pvl_with_ar": {
      "description": "术后即刻瓣周漏（中度以上主动脉瓣反流）",
      "conditions": [
        {"field": "immediate_pvl_occurred", "value": true},
        {"field": "moderate_severe_ar", "value": true}
      ]
    },
    "elderly_female_with_hypertension": {
      "description": "年龄大于75岁且有高血压的女性患者",
      "conditions": [
        {"field": "age", "operator": ">", "value": 75},
        {"field": "sex", "value": "Female"},
        {"field": "hypertension", "value": true}
      ]
    },
    "moderate_severe_pvl": {
      "description": "中度以上瓣周漏",
      "conditions": [
        {"field": "immediate_pvl_severity", "value": ["中度", "重度"]}
      ]
    },
    "high_risk_patients": {
      "description": "高风险患者（STS评分>8%）",
      "conditions": [
        {"field": "sts_score", "operator": ">", "value": 8}
      ]
    }
  },
